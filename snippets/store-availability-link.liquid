{% doc %}
  Brauz | 02-11-2026
  PDP find-in-store widget, rendered by Brauz. Sits directly below the
  quantity + Add to cart row, in place of the theme's own trigger button.

  Brauz mounts its widget iframe into #brauz-find-in-store-product-page:
  a "Check In Store Availability" row that opens the store finder drawer
  (snippets/store-availability-drawer.liquid) and a delivery post code check.

  Needs snippets/store-availability-drawer.liquid on the same page: it holds
  the Brauz config element and script, and the drawer the row opens.

  @example
  {% render 'store-availability-link' %}
{% enddoc %}

<div
  id="brauz-find-in-store-config-product-page"
  data-sd="{{ shop.permanent_domain }}"
  data-cvi="{{ product.first_available_variant.id }}"
  data-hodv="{{ product.has_only_default_variant }}"
  style="display: none; width: 0"
></div>

<div id="brauz-find-in-store-product-page" class="store-availability-link"></div>

{% stylesheet %}
  .store-availability-link {
    width: 100%;
  }
{% endstylesheet %}

<script src="https://d3aq2u4yw77ivo.cloudfront.net/find-in-store/shopify/highgrove/find-in-store.shopify.highgrove.prod.js?updated_at=04112026" async=""></script>